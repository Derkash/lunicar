# Configuration Email LUNICAR
# Copiez ce fichier en .env et remplissez vos valeurs

# Email de destination pour les demandes de reprise
EMAIL_TO=lunicar.auto@gmail.com

# Configuration SMTP Gmail
# Pour Gmail, vous devez créer un "Mot de passe d'application" :
# 1. Allez sur https://myaccount.google.com/security
# 2. Activez la validation en 2 étapes si ce n'est pas fait
# 3. Allez dans "Mots de passe des applications"
# 4. Créez un nouveau mot de passe pour "Mail" et "Autre (LUNICAR)"
# 5. Copiez le mot de passe généré (16 caractères sans espaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lunicar.auto@gmail.com
SMTP_PASS=votre_mot_de_passe_application

# Nom de l'expéditeur
SMTP_FROM_NAME=LUNICAR

# Téléphone et WhatsApp affichés sur le site (boutons d'appel, barre mobile).
# Tant qu'ils sont vides, aucun bouton d'appel n'apparaît.
LUNICAR_PHONE=
LUNICAR_WHATSAPP=

# Mot de passe de l'espace /admino (obligatoire en production)
CONVERSIONS_TOKEN=
ADMIN_USER=Elbagui224
ADMIN_PASSWORD=

# Recherche par plaque : caractéristiques SIV via une API licenciée (facultatif).
# Sans clé, seul le décodeur maison (datation de la plaque, gratuit) fonctionne.
# Clé RapidAPI de api-plaque-immatriculation.fr ; le quota plafonne les appels par mois.
# API plaque (apiplaqueimmatriculation.com par défaut) : token du compte, plafond d'appels par mois
PLAQUE_API_KEY=
PLAQUE_API_PROVIDER=apiplaque
PLAQUE_API_QUOTA=380
PLAQUE_API_QUOTA_JOUR=20

# Espace admin durable : Supabase (base + photos). Sans ces deux variables, stockage local
# (effacé à chaque déploiement Render). Clé « service_role » : Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Estimation automatique des demandes (annonces Leboncoin, cote, prix max d'achat) avec Claude.
ANTHROPIC_API_KEY=
# Facultatif : modèle, effort (low|medium|high), recherches web max, attente max de l'e-mail (s)
ESTIMATION_MODEL=claude-sonnet-5-5
ESTIMATION_EFFORT=medium
ESTIMATION_RECHERCHES=8
ESTIMATION_ATTENTE_S=150

# Import Gmail des anciennes demandes : par défaut les identifiants SMTP (même mot de passe d'application).
IMAP_USER=
IMAP_PASS=

# E-mails au client depuis la fiche (Écrire au client, Pas intéressé). Facultatif : à défaut, SMTP du site.
CONTACT_FROM=LUNICAR <contact@lunicar.fr>
CONTACT_REPLY_TO=contact@lunicar.fr
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
# Boîte où arrivent les réponses des clients (à défaut : IMAP_* / SMTP_*)
CONTACT_IMAP_HOST=imap.gmail.com
CONTACT_IMAP_USER=
CONTACT_IMAP_PASS=
# Boîte mail de l'admin (même boîte CONTACT_IMAP_*) : relève toutes les 3 min, lecture seule. 0 = relève auto coupée.
# BOITE_AUTO=1
# BOITE_IMAP_BOX=INBOX

# Veille Forums (admin) : recherche des discussions sur les forums. Vide = Reddit seul.
OPENAI_API_KEY=
# VEILLE_MODEL=gpt-5.4

# Robot Annonces (admin) : lit les e-mails d'alertes Leboncoin (recherches enregistrées), ne visite jamais leboncoin.fr.
# Boîte dédiée facultative ; à défaut : CONTACT_IMAP_*.
ANNONCES_IMAP_HOST=
ANNONCES_IMAP_PORT=993
ANNONCES_IMAP_USER=
ANNONCES_IMAP_PASS=
# ANNONCES_IMAP_BOX=INBOX
# Estimation légère sans recherche web (ANTHROPIC_API_KEY), plafond d'appels par passage, 0 = pas de relève auto
# ANNONCES_MODEL=claude-haiku-4-5
# ANNONCES_IA_MAX=20
# ANNONCES_AUTO=1

# Bing Webmaster Tools > Paramètres > Accès API > Clé API : soumission quotidienne des pages modifiées (100 URL/jour)
BING_API_KEY=
